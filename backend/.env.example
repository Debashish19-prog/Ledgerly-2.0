# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=expense_user
DB_PASSWORD=change-me
DB_NAME=expense_tracker
# Set to "true" for hosted MySQL that requires TLS (Aiven, TiDB Cloud, PlanetScale...)
DB_SSL=false
# CA certificate (PEM) for providers like Aiven; leave empty otherwise
DB_SSL_CA=

# Secret used to sign login tokens. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# API port, and the frontend URL allowed to call the API in development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
